# Tracker hit DQM services.
# Geometry and calibration settings originate from the validated trigger configuration.
# Panel mapping is supplied by the installed Offline conditions file by run number.
services: {
GeometryService: {
         KinKalMaterial: {
            CRVMaterialName: "CRVModule"
            ElectronBrehmsFraction: 3e-2
            GasScatteringFraction: 9.999999e-1
            IPAMaterialName: "HDPE"
            IonizationEnergyLossMode: 1
            STMaterialName: "Target"
            SolidScatteringFraction: 9.99999e-1
            elements: "Offline/TrackerConditions/data/ElementsList.data"
            isotopes: "Offline/TrackerConditions/data/IsotopesList.data"
            materials: "Offline/TrackerConditions/data/MaterialsList.data"
            strawGasMaterialName: "straw-gas"
            strawWallMaterialName: "straw-wall"
            strawWireMaterialName: "straw-wire"
         }
         bFieldFile: "Offline/Mu2eG4/geom/bfgeom_reco_v01.txt"
         inputFile: "Offline/Mu2eG4/geom/geom_common.txt"
         simulatedDetector: {
            tool_type: "Mu2e"
         }
      }

GlobalConstantsService: {
         inputFile: "Offline/GlobalConstantsService/data/globalConstants_01.txt"
      }

DbService: {
         dbName: "mu2e_conditions_prd"
         purpose: "EMPTY"
         textFile: [
            "TrkPreampStraw_117.txt",
            "TrkAlignTracker_138.txt",
            "TrkAlignPlane_139.txt",
            "TrkAlignPanel_140.txt",
            "TrkAlignStraw_171.txt",
            "TrkPanelStatus_110.txt",
            "TrkPlaneStatus_109.txt",
            "TrkStrawStatusShort_112.txt",
            "TrkStrawStatusLong_111.txt",
            "TrkDelayRStraw_41.txt",
            "CRVBadChan_296.txt",
            "CRVSiPM_294.txt",
            "CRVPhoton_188.txt",
            "CRVTime_295.txt",
            "TrkDelayPanel_19.txt",
            "Offline/TrackerConditions/data/TrkPanelMap.txt"
         ]
         verbose: 0
         version: "v0"
      }

ProditionsService: {

